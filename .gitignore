# Local machine state
.appdata/
.dotnet/
.localappdata/
downloads/
codex-proxy.cmd
proxy-investigation/
tools/procmon/
**/.mir2-data/

# JavaScript / frontend
**/node_modules/
**/.next/
**/.vercel/
**/next-env.d.ts
**/dist/
**/out/
**/*.tsbuildinfo

# Rust / build output
**/target/
**/target-build/
**/target-*/
/mir2-web3/target-commercial-prod/

# Deterministic native map derivatives are rebuilt at the packaging boundary.
/mir2-web3/apps/web/public/generated/native-map-keyed/

# Generated load evidence may contain local accounts and password hashes.
/mir2-web3/docs/generated/load/
/mir2-web3/docs/generated/**/accounts*.json

# Python bytecode caches
**/__pycache__/
**/*.py[cod]

# .NET build output
**/bin/
!mir2-web3/apps/gateway/src/bin/
!mir2-web3/apps/gateway/src/bin/**
!mir2-web3/apps/simulation/src/bin/
!mir2-web3/apps/simulation/src/bin/**
**/obj/

# Browser automation profiles and transient UI captures
**/.chrome-cdp-*/
**/.edge-cdp-*/
**/.tmp-*/
.mir2-player-qa/
**/.mir2-player-qa/
.wrangler/
**/.screens-*.png
**/screenshots/
**/playwright-report/
**/test-results/
mir2-web3/docs/generated/player-qa/movement-diagnostics/
mir2-web3/docs/generated/player-qa/movement-jitter/

# Logs and temporary notes
**/*.log
**/tmp_*.txt

# Repository-local recovery and diagnostic worktrees
/tmp/
/mir2-web3/tmp/
# Retain deliberately linked/malformed publication test outputs locally.
/mir2-web3/scripts/fixtures/native-r19-s15/qa-runs/fixtures/
/mir2-web3/scripts/fixtures/native-r19-s15/qa-runs/interrupt-fixtures/
/.codex/backups/
/refactor-pwa/

# The full Crystal sound export is published through R2; keep only files
# that are already intentionally tracked as local baselines.
/mir2-web3/apps/web/public/original-ui/Sound/*.wav
# These Source-pinned pet sounds are required by the native build/test closure.
!/mir2-web3/apps/web/public/original-ui/Sound/pet_blackdragon.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_chick.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_frog.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_kitty.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_monkey.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_olympicmascot.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_pickup.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_pig.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_pigman.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_skeleton.wav
!/mir2-web3/apps/web/public/original-ui/Sound/pet_weman.wav

