# Mir2 Gateway Postgres+Redis internal/staging environment.
# Copy to /etc/mir2/gateway.env and replace secrets before starting systemd.

# Staging/prod-like mode fails closed unless Postgres account storage and Redis
# session/routing cache are configured.
MIR2_ENV=staging

# Web clients use the HTTP/WebSocket gateway. Keep TCP loopback-only unless a
# Crystal TCP client needs direct access.
MIR2_GATEWAY_WEB_ADDR=0.0.0.0:7110
MIR2_GATEWAY_TCP_ADDR=127.0.0.1:7000

# Postgres account/character source of truth.
MIR2_ACCOUNT_STORE_BACKEND=postgres
MIR2_ACCOUNT_STORE_REQUIRE_POSTGRES=1
MIR2_ACCOUNT_STORE_DATABASE_URL=postgres://mir2:replace-password@127.0.0.1:5432/mir2
MIR2_ACCOUNT_STORE_PG_POOL_MAX_SIZE=8
MIR2_ACCOUNT_STORE_PG_POOL_WAIT_TIMEOUT_MS=2000
MIR2_ACCOUNT_STORE_PG_CONNECT_TIMEOUT_MS=3000

# Legacy JSON path can still be used for import/export or local fallback when
# MIR2_ENV is not staging/prod-like, but it is not the runtime source above.
MIR2_ACCOUNT_STORE_PATH=/var/lib/mir2/accounts.json

# Optional but recommended before walking beyond the embedded starter/Bichon
# coverage. Install with scripts/install-crystal-map-assets.sh.
# CRYSTAL_CLIENT_ROOT=/var/lib/mir2/crystal-client/current

# Capacity guardrails for a <=10-player smoke server.
MIR2_GATEWAY_MAX_WS_CONNECTIONS=20
MIR2_GATEWAY_MAX_ACTIVE_SESSIONS=10
MIR2_GATEWAY_MAX_RECONNECT_LEASES=10
MIR2_GATEWAY_RECONNECT_GRACE_SECONDS=15
MIR2_GATEWAY_ENFORCE_PLAYER_COMMAND_SAFETY=1
MIR2_GATEWAY_RUNTIME_TICK_MS=300
MIR2_GATEWAY_TOKIO_WORKER_THREADS=4

# Redis route/session cache and StartGame route-admission leases.
MIR2_GATEWAY_REDIS_CACHE_URL=redis://127.0.0.1:6379
MIR2_GATEWAY_REQUIRE_REDIS_CACHE=1
MIR2_GATEWAY_SESSION_CACHE_TTL_SECONDS=30
MIR2_GATEWAY_ROUTE_LEASE_TTL_SECONDS=30
MIR2_GATEWAY_ROUTE_REFRESH_INTERVAL_MS=5000

# Use the same value in Player Web / Vercel MIR2_PASSKEY_AUTH_SECRET if passkey
# login is enabled.
MIR2_PASSKEY_AUTH_SECRET=replace-with-random-32-byte-secret

# Optional: Admin API / analytics integration.
# ADMIN_API_BASE_URL=http://127.0.0.1:7420
# MIR2_GATEWAY_ADMIN_OPERATOR_TOKEN=replace-with-gateway-operator-token
# MIR2_GAMEPLAY_EVENT_REDPANDA_URL=http://127.0.0.1:8082
# MIR2_GAMEPLAY_EVENT_TOPIC=gameplay.command.executed
