MIR2_EARLY_POSTGRES_PASSWORD=replace-with-url-safe-random-password
MIR2_EARLY_ZONE_TOKEN=replace-with-at-least-32-random-bytes
# Required exactly once. Keep empty in this example; inject a distinct,
# stable 32-byte/64-hex value from a secret manager at deployment time.
MIR2_GATEWAY_SAVE_RECOVERY_MAC_KEY=
MIR2_EARLY_TCP_PORT=7000
MIR2_EARLY_WEB_PORT=7010
