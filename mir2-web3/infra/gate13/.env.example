# Absolute paths. Generate with:
# cargo +1.89.0 run -p mir2-gateway --bin node_identity -- generate /secure/path/node.key
GATE13_NODE_SIGNING_KEY_FILE=/absolute/path/to/active-testnet-node.key
GATE13_CAPACITY_ISSUER_KEY_FILE=/absolute/path/to/capacity-issuer.key

# Optional host-port and output overrides:
# GATE13_ZONE_RPC_PORT=27220
# GATE13_ZONE_METRICS_PORT=29100
# GATE13_EVIDENCE_DIR=/absolute/path/to/evidence
