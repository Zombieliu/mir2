# Local development is bound to loopback by default.
MIR2_BIND_ADDRESS=127.0.0.1
MIR2_WEB_PORT=3002
MIR2_GATEWAY_WEB_PORT=7110
MIR2_GATEWAY_TCP_PORT=7000
MIR2_GATEWAY_WS_URL=ws://127.0.0.1:7110/ws

# Leave empty for the repository-local Starter pack. Use an immutable version URL
# after the full pack has been published to an authorized object store.
MIR2_ASSET_BASE_URL=

# CI and release automation can override this with a digest-pinned GHCR image.
MIR2_DEV_IMAGE=mir2-web3-developer:local
