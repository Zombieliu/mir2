{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "mir2-r2-asset-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-18",
  "account_id": "85bf64d86ea9221e172d26feba9fd47e",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "assets.mir2.obelisk.build/*",
      "zone_name": "obelisk.build"
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MIR2_ASSETS",
      "bucket_name": "mir2-web3-assets"
    }
  ],
  "vars": {
    "MIR2_ALLOWED_PREFIX": "mir2/v/",
    "MIR2_CACHE_CONTROL": "public, max-age=31536000, immutable",
    "MIR2_FALLBACK_OBJECT_PREFIX": "mir2/v/20260730-fullcrystal-f71b89aa-gzip1",
    "MIR2_OVERLAY_OBJECT_PREFIX": "mir2/v/20260818-main-97887dcd"
  }
}
