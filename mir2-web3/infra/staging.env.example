# Mir2 staging environment template.
# Copy values into your deployment platform secret/config store. Do not commit
# real staging or production credentials.

# Public service URLs
ADMIN_WEB_URL=https://admin-staging.example.com
PLAYER_WEB_URL=https://play-staging.example.com
GATEWAY_PUBLIC_HTTP_URL=https://gateway-staging.example.com
GATEWAY_PUBLIC_WS_URL=wss://gateway-staging.example.com/ws
ADMIN_API_INTERNAL_URL=http://mir2-admin-api:7420
GATEWAY_INTERNAL_HTTP_URL=http://mir2-gateway:7110

# Admin API
ADMIN_API_ADDR=0.0.0.0:7420
ADMIN_DATABASE_URL=postgres://mir2:${POSTGRES_PASSWORD}@postgres:5432/mir2
ADMIN_OPERATOR_AUTH_BACKEND=postgres
ADMIN_APPROVAL_ALLOW_SELF=false
ADMIN_GATEWAY_MAIL_URL=http://mir2-gateway:7110/admin/system-mail
ADMIN_GATEWAY_KICK_URL=http://mir2-gateway:7110/admin/kick-player
ADMIN_GATEWAY_SESSIONS_URL=http://mir2-gateway:7110/admin/sessions
ADMIN_GATEWAY_SERVICE_TRACE_URL=http://mir2-gateway:7110/admin/session-trace
# Optional fallback when the real Gateway has not embedded Gate15 details.
ADMIN_COMMONWARE_GATEWAY_URL=http://gate14-gateway:9500

# AI World Director Approval Beta. Signing seeds and shared control tokens must
# be injected by the secret manager, never stored in this file.
MIR2_WORLD_DIRECTOR_SIGNING_KEY=${WORLD_DIRECTOR_SIGNING_KEY}
MIR2_WORLD_DIRECTOR_VALIDATOR_KEYS=${WORLD_DIRECTOR_VALIDATOR_KEYS}
MIR2_WORLD_DIRECTOR_COMMONWARE_GATEWAY_URL=http://gate14-gateway:9500
MIR2_WORLD_DIRECTOR_COMMONWARE_GATEWAY_TOKEN=${GATE14_CONTROL_TOKEN}
MIR2_WORLD_DIRECTOR_REQUIRE_REMOTE_COMMONWARE=true
MIR2_WORLD_DIRECTOR_ZONE_HOST_URLS=http://zone-host:9100
MIR2_WORLD_DIRECTOR_MANAGEMENT_TOKEN=${WORLD_DIRECTOR_MANAGEMENT_TOKEN}
MIR2_WORLD_DIRECTOR_GAME_ID=mir2
MIR2_WORLD_DIRECTOR_REGION_ID=asia-hk
MIR2_WORLD_DIRECTOR_AUTOMATIC_GENERATION=true
MIR2_WORLD_DIRECTOR_GENERATION_INTERVAL_SECONDS=300
# Keep secrets in the deployment secret manager. Set mode=openai only when
# MIR2_WORLD_DIRECTOR_AI_API_KEY is injected into the Admin API container.
MIR2_WORLD_DIRECTOR_PROPOSAL_MODE=rule
MIR2_WORLD_DIRECTOR_AI_API_KEY=${WORLD_DIRECTOR_AI_API_KEY}
MIR2_WORLD_DIRECTOR_AI_ENDPOINT=https://api.openai.com/v1/responses
MIR2_WORLD_DIRECTOR_AI_MODEL=gpt-5.6-terra
MIR2_WORLD_DIRECTOR_AI_REASONING_EFFORT=low
MIR2_WORLD_DIRECTOR_AI_TIMEOUT_SECONDS=45

# Gate14 Gateway and Zone Host receive the corresponding public/control side.
GATE14_CONTROL_TOKEN=${GATE14_CONTROL_TOKEN_SECRET}
GATE14_REQUIRE_CONTROL_TOKEN=true
MIR2_WORLD_DIRECTOR_TRUSTED_PUBLIC_KEY=${WORLD_DIRECTOR_PUBLIC_KEY}
MIR2_WORLD_DIRECTOR_COMMITTEE=${WORLD_DIRECTOR_COMMITTEE_PUBLIC_KEYS}
MIR2_WORLD_DIRECTOR_CHECKPOINT_FILE=/var/lib/mir2/world-director-runtime.json
MIR2_ZONE_HOST_MANAGEMENT_TOKEN=${WORLD_DIRECTOR_MANAGEMENT_TOKEN}

# Admin outbox and analytics
NATS_ADDR=nats:4222
ADMIN_OUTBOX_NATS_MODE=jetstream
ADMIN_OUTBOX_NATS_STREAM=MIR2_ADMIN
ADMIN_OUTBOX_POLL_MS=1000
ADMIN_OUTBOX_MAX_ATTEMPTS=5
ADMIN_OUTBOX_REDPANDA_URL=http://redpanda:8082
ADMIN_CLICKHOUSE_URL=http://clickhouse:8123
ADMIN_CLICKHOUSE_DATABASE=mir2_events
ADMIN_CLICKHOUSE_USER=mir2
ADMIN_CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD}

# Gameplay account store
MIR2_ACCOUNT_STORE_BACKEND=postgres
MIR2_ACCOUNT_STORE_REQUIRE_POSTGRES=1
MIR2_ACCOUNT_STORE_DATABASE_URL=postgres://mir2:${POSTGRES_PASSWORD}@postgres:5432/mir2
MIR2_ACCOUNT_STORE_PATH=/var/lib/mir2/accounts.json

# Gateway
MIR2_GATEWAY_TCP_ADDR=0.0.0.0:7000
MIR2_GATEWAY_WEB_ADDR=0.0.0.0:7110
MIR2_GATEWAY_REDIS_CACHE_URL=redis://redis:6379
MIR2_GATEWAY_REQUIRE_REDIS_CACHE=1
MIR2_GATEWAY_SESSION_CACHE_TTL_SECONDS=30
MIR2_GATEWAY_ROUTE_LEASE_TTL_SECONDS=30
MIR2_GATEWAY_TRACE_HISTORY_TTL_SECONDS=86400
MIR2_GATEWAY_ID=staging-gateway-1
MIR2_GATEWAY_PUBLIC_ENDPOINT=https://gateway-staging.example.com
MIR2_GATEWAY_RELAY_ID=relay-hk-1
MIR2_GATEWAY_RELAY_ENDPOINT=relay-hk.example.com:443
MIR2_GATEWAY_NODE_KIND=official
MIR2_GAMEPLAY_EVENT_REDPANDA_URL=http://redpanda:8082
MIR2_GAMEPLAY_EVENT_TOPIC=gameplay.command.executed
# Shared by Gateway heartbeat and Admin Web server actions.
ADMIN_API_BASE_URL=http://mir2-admin-api:7420
MIR2_GATEWAY_ADMIN_OPERATOR_TOKEN=${GATEWAY_OPERATOR_TOKEN}
MIR2_GATEWAY_ZONE_ID=staging-zone-1
MIR2_GATEWAY_ZONE_NAME=Staging Zone 1
MIR2_GATEWAY_ZONE_HOST=mir2-gateway:7110
MIR2_GATEWAY_ZONE_TICK_RATE=20
MIR2_GATEWAY_ZONE_HEARTBEAT_INTERVAL_SECONDS=10

# Admin Web
# Optional bootstrap fallback only. Prefer login cookie tokens in staging.
ADMIN_OPERATOR_TOKEN=
# Shared only between Admin Web and the TLS reverse proxy in front of Admin API.
ADMIN_API_PROXY_TOKEN=${ADMIN_API_PROXY_TOKEN_SECRET}
ADMIN_API_TIMEOUT_MS=8000
DUBHE_HOME_TELEMETRY_URL=https://relay-hk.example.com/home/telemetry
DUBHE_HOME_TELEMETRY_OPERATOR_TOKEN=${HOME_TELEMETRY_OPERATOR_TOKEN}

# Player Web
NEXT_PUBLIC_MIR2_GATEWAY_WS_URL=wss://gateway-staging.example.com/ws
# If NEXT_PUBLIC_MIR2_GATEWAY_WS_URL is unset outside localhost, Player Web
# falls back to same-origin /ws.

# Required deployment secrets. Keep these in your secret manager.
POSTGRES_PASSWORD=replace-with-staging-postgres-password
CLICKHOUSE_PASSWORD=replace-with-staging-clickhouse-password
GATEWAY_OPERATOR_TOKEN=replace-with-random-gateway-operator-token
LEAD_OPERATOR_TOKEN=replace-with-random-lead-operator-token
PEER_OPERATOR_TOKEN=replace-with-random-peer-operator-token
HOME_TELEMETRY_OPERATOR_TOKEN=replace-with-random-home-telemetry-read-token
ADMIN_API_PROXY_TOKEN_SECRET=replace-with-random-admin-api-proxy-token
GATE14_CONTROL_TOKEN_SECRET=replace-with-random-gate14-control-token
WORLD_DIRECTOR_SIGNING_KEY=replace-with-url-safe-base64-ed25519-seed
WORLD_DIRECTOR_VALIDATOR_KEYS=replace-with-four-comma-separated-ed25519-seeds
WORLD_DIRECTOR_PUBLIC_KEY=replace-with-director-public-key
WORLD_DIRECTOR_COMMITTEE_PUBLIC_KEYS=replace-with-four-comma-separated-public-keys
WORLD_DIRECTOR_MANAGEMENT_TOKEN=replace-with-random-zone-management-token

# Optional bootstrap fallback policy path. Enable only for the first operator
# seed run, and leave ADMIN_OPERATOR_AUTH_BACKEND unset during that bootstrap.
# ADMIN_OPERATOR_POLICY_PATH=/etc/mir2/admin-operator-policy.bootstrap.json
