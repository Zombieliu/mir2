# Docker Desktop in the current acceptance host exposes 10 CPU and 7.75 GiB.
# This 6 GiB tier is the largest honest local memory-constrained profile.
DUBHE_PROFILE_LABEL=8c6g-50mbps-500gb
DUBHE_PROFILE_CPU_CORES=8
DUBHE_PROFILE_MEMORY_BYTES=6442450944
DUBHE_PROFILE_NETWORK_EGRESS_MBPS=50
DUBHE_PROFILE_DISK_BYTES=500000000000
DUBHE_PROFILE_SAFETY_BPS=7000

# Dense same-map movement/AOI curve.
MIR2_LOAD_STEPS=1,5,10,25,50,75,100,125,150,200,300,400,500,600
MIR2_LOAD_TICKS=120
MIR2_LOAD_BUDGET_MS=100
MIR2_LOAD_COMMAND_INTERVAL_MS=700

# Independent multi-Zone scaling curve.
MIR2_LOAD_ZONES=1,2,3,4,6,8
MIR2_LOAD_ZONE_PLAYER_STEPS=25,50,75,100,150
MIR2_LOAD_ZONE_TICKS=40
