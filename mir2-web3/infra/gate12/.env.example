MIR2_ZONE_HOST_TOKEN=replace-with-a-random-zone-rpc-token
GATE12_GRAFANA_ADMIN_PASSWORD=replace-me

# `run-acceptance.sh` creates two ephemeral mode-0600 Ed25519 keys. For manual
# `docker compose up`, generate and set two distinct absolute key paths:
# GATE12_ZONE_A_SIGNING_KEY_FILE=/absolute/path/to/zone-a.key
# GATE12_ZONE_B_SIGNING_KEY_FILE=/absolute/path/to/zone-b.key

# Optional host-port overrides:
# GATE12_ZONE_A_RPC_PORT=17020
# GATE12_ZONE_B_RPC_PORT=17021
# GATE12_ZONE_A_METRICS_PORT=19100
# GATE12_ZONE_B_METRICS_PORT=19101
# GATE12_GATEWAY_TCP_PORT=17000
# GATE12_GATEWAY_WEB_PORT=17010
# GATE12_PROMETHEUS_PORT=19090
# GATE12_GRAFANA_PORT=13000
