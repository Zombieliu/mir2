# Isolated invited playtest. THIS TEMPLATE IS NOT RUNNABLE.
# Provision /etc/mir2-playtest/gateway.env as root:root 0600, from trusted input.
# Replace every REQUIRED_* value; all five secrets must be independent.
# Never copy the existing production env, keys, player database or demo save.
MIR2_ENV=staging
MIR2_DEPLOY_REVISION=REQUIRED_FULL_SOURCE_REVISION
MIR2_GATEWAY_ID=mir2-playtest
MIR2_REALM_ID=mir2-invited-playtest
MIR2_GATEWAY_PUBLIC_ENDPOINT=wss://165.154.65.136.sslip.io/playtest/ws
MIR2_GATEWAY_WEB_ADDR=127.0.0.1:7210
MIR2_GATEWAY_TCP_ADDR=127.0.0.1:7200
MIR2_CONTENT_PROFILE=platinum_176
MIR2_QUEST_CADENCE=newcomer-v2
MIR2_SIMULATION_FIXED_LIGHT_SETTING=day

MIR2_ACCOUNT_STORE_BACKEND=postgres
MIR2_ACCOUNT_STORE_REQUIRE_POSTGRES=1
MIR2_ACCOUNT_STORE_DATABASE_URL=postgres://mir2_playtest:REQUIRED_PRIVATE_DB_PASSWORD@127.0.0.1:5432/mir2_playtest
MIR2_ACCOUNT_STORE_PG_POOL_MAX_SIZE=4
MIR2_ACCOUNT_STORE_PG_POOL_WAIT_TIMEOUT_MS=2000
MIR2_ACCOUNT_STORE_PG_CONNECT_TIMEOUT_MS=3000
# JSON is not a fallback in staging. Keep even the unused path inside this realm.
MIR2_ACCOUNT_STORE_PATH=/var/lib/mir2-playtest/state/accounts.json
MIR2_CHANNEL_IDENTITY_DATABASE_URL=postgres://mir2_playtest:REQUIRED_PRIVATE_DB_PASSWORD@127.0.0.1:5432/mir2_playtest
MIR2_REQUIRE_CHANNEL_IDENTITY_POSTGRES=1
MIR2_REQUIRE_CHANNEL_IDENTITY_STORE=1
MIR2_CHANNEL_IDENTITY_PG_POOL_MAX_SIZE=2

# 64 random hexadecimal characters; retain this exact key with all journals.
MIR2_SAVE_RECOVERY_DIR=/var/lib/mir2-playtest/recovery
MIR2_SAVE_RECOVERY_MAC_KEY=REQUIRED_64_HEX_KEY
# Three separate CSPRNG secrets, at least 32 characters each. Placeholders below
# are deliberately too short to pass staging identity validation.
MIR2_PASSKEY_AUTH_SECRET=REQUIRED_PASSKEY_SECRET
MIR2_IDENTITY_POLICY=commercial
MIR2_IDENTITY_SESSION_SECRET=REQUIRED_SESSION_SECRET
MIR2_IDENTITY_RECOVERY_PEPPER=REQUIRED_RECOVERY_PEPPER
MIR2_IDENTITY_SESSION_TTL_SECONDS=43200

# Immutable matching source map pack, copied as actual regular files.
MIR2_CRYSTAL_MAP_PACK=/opt/mir2-playtest/releases/REQUIRED_FULL_SOURCE_REVISION/crystal-map-pack

# Dedicated Redis process at a different port. The current cache implementation
# does not implement AUTH or SELECT. No password/DB suffix is claimed here.
# Host access is the trust boundary; never expose 6381 outside loopback.
MIR2_GATEWAY_REDIS_CACHE_URL=redis://127.0.0.1:6381
MIR2_GATEWAY_REQUIRE_REDIS_CACHE=1
MIR2_GATEWAY_SESSION_CACHE_TTL_SECONDS=30
MIR2_GATEWAY_ROUTE_LEASE_TTL_SECONDS=30
MIR2_GATEWAY_ROUTE_REFRESH_INTERVAL_MS=5000

# This is an admission ceiling, not evidence of fifteen-player performance.
MIR2_GATEWAY_MAX_WS_CONNECTIONS=30
MIR2_GATEWAY_MAX_ACTIVE_SESSIONS=15
MIR2_GATEWAY_MAX_RECONNECT_LEASES=15
MIR2_GATEWAY_RECONNECT_GRACE_SECONDS=15
MIR2_GATEWAY_MAX_LOGIN_IN_FLIGHT=2
MIR2_GATEWAY_MAX_NEW_CHARACTER_IN_FLIGHT=1
MIR2_GATEWAY_MAX_START_GAME_IN_FLIGHT=2
MIR2_GATEWAY_RUNTIME_TICK_MS=300
MIR2_GATEWAY_TOKIO_WORKER_THREADS=4

# Matches the origin sent by the native client for the WSS endpoint above.
# Do not add '*', absent-Origin exemptions, or a Basic Auth challenge on /ws.
MIR2_ALLOWED_WEB_ORIGINS=https://165.154.65.136.sslip.io
# Only for this loopback-only listener behind the paired Caddy route, which
# overwrites this header with the actual TCP client IP. Never trust the incoming
# public header unchanged or bind this listener to a public interface.
MIR2_TRUST_CF_CONNECTING_IP=1
# No demo account, development secret opt-in, unsafe player commands, admin API,
# on-chain injection token or production validator/Zone host configuration.
