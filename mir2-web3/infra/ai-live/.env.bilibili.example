# Optional external encoder route. Bilibili account must officially permit
# third-party RTMP publishing. Without that permission use official LiveHime
# window capture of the local spectator page instead.
# Replace with a reachable spectator frontend configured for the playtest realm.
# A Node server listening only on 127.0.0.1 is not reachable from this container.
MIR2_AI_LIVE_RENDER_URL=https://watch.example.invalid/spectate?aiLive=1&aiLiveAudio=0&spectateMap=0&spectateDelayMs=30000&bevyRuntime=0
MIR2_AI_LIVE_OUTPUT_FORMAT=rtmp
# Mount a private file containing the complete address + stream key. Do not
# place a key in this template, a public URL, a Git file or a screenshot.
MIR2_AI_LIVE_OUTPUT_URL_FILE=/run/secrets/rtmp-output-url
MIR2_AI_DISTRIBUTION_RTMP_PLATFORM=bilibili
MIR2_AI_LIVE_VIDEO_SIZE=1280x720
MIR2_AI_LIVE_FRAME_RATE=30
MIR2_AI_LIVE_VIDEO_BITRATE=3000k
MIR2_AI_LIVE_AUDIO_BITRATE=128k
