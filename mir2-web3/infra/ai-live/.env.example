# Public, tokenized spectator URL loaded by the isolated Chromium encoder.
MIR2_AI_LIVE_RENDER_URL=http://host.docker.internal:3002/spectate?aiLive=1&aiLiveAudio=1&spectateMode=director&spectateToken=replace-me

# Leave empty for local HLS under ./artifacts/ai-live/hls/live.m3u8.
# For a provider, use the complete secret RTMPS ingest URL and never commit it.
MIR2_AI_LIVE_OUTPUT_URL=
MIR2_AI_LIVE_OUTPUT_FORMAT=hls
MIR2_AI_LIVE_VIDEO_SIZE=1920x1080
MIR2_AI_LIVE_FRAME_RATE=30
MIR2_AI_LIVE_VIDEO_BITRATE=4500k
MIR2_AI_LIVE_AUDIO_BITRATE=128k
