# YouTube Live launch profile. Copy this file to an untracked secret file.
MIR2_AI_LIVE_RENDER_URL=https://mir2.obelisk.build/spectate?aiLive=1&aiLiveAudio=1&spectateMode=director&spectateToken=replace-me

# Paste YouTube's complete RTMPS ingest URL plus stream key here.
# Never commit the real value.
MIR2_AI_LIVE_OUTPUT_URL=rtmps://a.rtmps.youtube.com/live2/replace-with-stream-key
MIR2_AI_LIVE_OUTPUT_FORMAT=rtmp
MIR2_AI_LIVE_VIDEO_SIZE=1920x1080
MIR2_AI_LIVE_FRAME_RATE=30
MIR2_AI_LIVE_VIDEO_BITRATE=4500k
MIR2_AI_LIVE_AUDIO_BITRATE=128k

# The Gateway and encoder must share this secret.
MIR2_AI_DISTRIBUTION_HEARTBEAT_URL=https://gateway.example/ai-live/distribution/heartbeat
MIR2_AI_DISTRIBUTION_HEARTBEAT_TOKEN=replace-with-at-least-24-random-characters
MIR2_AI_DISTRIBUTION_RTMP_PLATFORM=youtube
MIR2_AI_DISTRIBUTION_WORKER_ID=youtube-primary-01
