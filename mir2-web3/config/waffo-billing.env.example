# Merge into the existing private Gateway/Source configuration. Disabled by default.
# Keep merchant credentials and PEM files outside the repository.
MIR2_WAFFO_ENABLED=0
MIR2_WAFFO_ENVIRONMENT=sandbox
MIR2_WAFFO_MERCHANT_ID=replace_with_merchant_id
MIR2_WAFFO_API_KEY=replace_with_api_key
# Set absolute paths in your private configuration directory. The public key is
# WAFFO's verification key, not the merchant's own public key.
MIR2_WAFFO_PRIVATE_KEY_FILE="<private-config>/waffo-merchant-private.pem"
MIR2_WAFFO_PUBLIC_KEY_FILE="<private-config>/waffo-platform-public.pem"
MIR2_BILLING_PUBLIC_BASE_URL=https://replace-with-existing-billing-origin.example
# Example quotes match the existing Stripe test catalogue; server quotes own Credits.
MIR2_WAFFO_RECHARGE_OFFERS='[{"id":"usd-1","label":"100 Credits","currency":"usd","amountMinor":100,"credits":100},{"id":"usd-5","label":"500 Credits","currency":"usd","amountMinor":500,"credits":500},{"id":"usd-10","label":"1000 Credits","currency":"usd","amountMinor":1000,"credits":1000},{"id":"usd-20","label":"2000 Credits","currency":"usd","amountMinor":2000,"credits":2000}]'
# Retain the existing approved monthly-card price; don't duplicate conflicting values.
# MIR2_MONTHLY_CARD_CREDIT_PRICE=1000
