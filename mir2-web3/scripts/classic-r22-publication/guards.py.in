#!/usr/bin/env python3
"""Narrow, fixed-R17, add-only Linux accelerator publisher.

No CMS implementation, network, credentials, service control, feed writes or
deletion. Consumes the exact frozen root-verified envelope; hashes are not CMS.
All CLI roots are production-fixed or fresh private /srv staging siblings.
Tests may call the explicitly bounded internal fixture API; CLI cannot select it.
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import ctypes
from dataclasses import dataclass
import errno
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import struct
import sys
import threading
import time
import zlib

sys.dont_write_bytecode = True
PUBLIC_ROOT = Path('/srv/mir2-client-updates')
GAME_DIRECTORY = 'releases/game-WN-CANDIDATE-20261004-invited-17'
OLD_DIRECTORY = 'releases/game-WN-CANDIDATE-20261003-invited-16'
CANDIDATE = 'WN-CANDIDATE-20261004-invited-17'
GAME_SOURCE = '6032ef8b3e27dd97bad0b20c8676ef9f185db64b'
TOOL_SOURCE = '4c60c323aed11829abae6ee5ce6e13c675a3c1c3'
LOCK_PATH = Path('/var/backups/mir2-client-updates/.publisher.lock')
PRIVATE_STAGE = Path('/srv/.mir2-origin-r17-acceleration-20261005-01')
PUBLIC_KEY_SHA = '6c70c777b27d50949370d494b4b25798200fbdd5c171baeeaa94d7e289900f3e'
META_NAMES = ('PACKAGE-MANIFEST.json', 'VERSION.json', 'RELEASE-STATEMENT.json', 'RELEASE-STATEMENT.p7s')
CHUNK = 64 * 1024
MAX_META = 32 * 1024**2
MAX_COMPRESSED = 128 * 1024**2
MAX_EXPANDED = 512 * 1024**2
MAX_TOTAL = 4 * 1024**3
FIXTURE_BASE = Path(__file__).resolve().parent / 'fixtures'


class Refusal(Exception):
    pass


def need(condition, code):
    if not condition:
        raise Refusal(code)


def sha(data):
    return hashlib.sha256(data).hexdigest()


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True) + '\n').encode('ascii')


def parse(data):
    def pairs(items):
        result = {}
        for key, value in items:
            need(key not in result, 'duplicate-json-key')
            result[key] = value
        return result
    try:
        def constant(_value):
            raise Refusal('nonfinite-json-number')
        return json.loads(data, object_pairs_hook=pairs, parse_constant=constant)
    except (UnicodeError, ValueError, TypeError):
        raise Refusal('invalid-json') from None


def keys(value, expected, code):
    need(isinstance(value, dict) and set(value) == set(expected), code)


def relative(value):
    need(isinstance(value, str) and 0 < len(value) <= 230
         and re.fullmatch(r'[A-Za-z0-9._/#% +()\[\]-]+', value) is not None,
         'unsafe-relative-path')
    for component in value.split('/'):
        need(component not in ('', '.', '..') and not component.startswith('.')
             and not component.endswith(('.', ' ')) and ':' not in component,
             'unsafe-path-component')
        need(component.split('.', 1)[0].upper() not in {'CON', 'PRN', 'AUX', 'NUL',
            *(f'COM{n}' for n in range(1, 10)), *(f'LPT{n}' for n in range(1, 10))},
            'reserved-path-component')
    return value


def item(value, limit=MAX_EXPANDED):
    keys(value, ('path', 'size', 'sha256'), 'file-entry-fields')
    relative(value['path'])
    need(type(value['size']) is int and 0 <= value['size'] <= limit
         and isinstance(value['sha256'], str)
         and re.fullmatch(r'[0-9a-fA-F]{64}', value['sha256']) is not None,
         'file-entry-bounds')
    return {'path': value['path'], 'size': value['size'], 'sha256': value['sha256'].lower()}


def plan_item(value):
    # The original workstation source field is inert evidence, never a path input.
    keys(value, ('path', 'source', 'size', 'sha256'), 'plan-entry-fields')
    need(isinstance(value['source'], str) and 0 < len(value['source']) <= 4096,
         'plan-source-evidence-bound')
    return item({key: value[key] for key in ('path', 'size', 'sha256')},
                MAX_META if value['path'].endswith(('.json', '.p7s', '.txt')) else MAX_COMPRESSED)


def fingerprint(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid,
            info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def posix_metadata(info, directory, private=False):
    need(info.st_uid == 0 and not info.st_mode & 0o022, 'non-root-or-shared-writable-path')
    need(stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode), 'wrong-path-type')
    if not directory:
        need(info.st_nlink == 1, 'hardlinked-file')
    if private:
        need(not info.st_mode & 0o077, 'non-private-path')


