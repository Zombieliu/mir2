      "beforeApplyStartLine": 113,
      "old": "$arguments=@((Join-Path 'C:/Users/Administrator/.codex/worktrees/r2-client-delivery/mir2-player-journey/mir2-web3/apps/game-client/windows-updater/scripts' 'verify-native-delivery.py'),'--candidate-root',$CandidateRoot,'--delivery-root',$DeliveryRoot,\n",
