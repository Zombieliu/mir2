<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources></RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="Shared"><HintPath>$(FrozenRuntimeDirectory)/Shared.dll</HintPath></Reference>
    <Reference Include="Server.Library"><HintPath>$(FrozenRuntimeDirectory)/Server.Library.dll</HintPath></Reference>
    <None Include="$(FrozenRuntimeDirectory)/*.dll" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="ComparableSourceLockSha256" Value="$(SourceLockSha256)" />
  </ItemGroup>
  <Target Name="RequirePinnedInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(FrozenRuntimeDirectory)' == '' Or '$(SourceLockSha256)' == ''" Text="Use build.py with the frozen runtime directory and generated source lock." />
  </Target>
</Project>
