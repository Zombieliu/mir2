  "branch": "codex/windows-player-journey",
  "changes": [
    "Native GuildMemberChange handles real delta statuses without clearing unrelated ranks/members",
    "Typed UserInformation identity reaches the social cursor, using realId rather than AOI/selection IDs",
    "Exact local permission context retains option/value/requester/guild/scope and actual status7 cursor across metadata",
    "Typed roster read retains a fresh255 cursor, exact definitely-unsent cancellation and retry after real bounded-channel rejection",
    "Pending permission/read/rename intents are protected from ordinary queue eviction; original24/8 limits remain"
  ],
