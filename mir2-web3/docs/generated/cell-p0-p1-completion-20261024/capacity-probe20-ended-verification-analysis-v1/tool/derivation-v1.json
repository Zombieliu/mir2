      "afterUtf8": "// Pure diagnostic appendix: malformed or absent rows never change original game adjudication.\nfunction createScoutDiagnosticAppendix(){\n const fields=['hintCount','activeOtherWaypointCount','sharedHintCount','unsharedHintCount','hintPreferenceReason'],allowed=new Set(['insufficient-hints','no-active-other-waypoints','reordered','all-hints-shared','all-hints-unshared']);\n const summary={rows:0,detailedRows:0,truncationSentinels:0,missingFieldRows:0,invalidTypeRows:0,unknownReasonRows:0,reasonCounts:{},fieldPresence:Object.fromEntries(fields.map(k=>[k,0])),selected:[],selectedTruncated:false,observed:false,contributesToGameAcceptance:false};\n const scalar=v=>v===null||typeof v==='boolean'||(typeof v==='number'&&Number.isFinite(v))?v:typeof v==='string'?v.slice(0,80):'[non-scalar-or-missing]';\n return{observe(r,line){summary.rows++;summary.observed=true;if(r.truncated===true){summary.truncationSentinels++;if(summary.selected.length<32)summary.selected.push({line,actor:scalar(r.actor),phase:scalar(r.phase),truncated:true,rowLimit:scalar(r.rowLimit)});else summary.selectedTruncated=true;return;}summary.detailedRows++;const present=fields.every(k=>Object.hasOwn(r,k));for(const k of fields)if(Object.hasOwn(r,k))summary.fieldPresence[k]++;if(!present)summary.missingFieldRows++;const count=(v,max)=>Number.isSafeInteger(v)&&v>=0&&v<=max;const valid=count(r.hintCount,4)&&(r.activeOtherWaypointCount===null||count(r.activeOtherWaypointCount,100))&&(r.sharedHintCount===null||count(r.sharedHintCount,4))&&(r.unsharedHintCount===null||count(r.unsharedHintCount,4))&&typeof r.hintPreferenceReason==='string';if(!valid)summary.invalidTypeRows++;if(allowed.has(r.hintPreferenceReason))summary.reasonCounts[r.hintPreferenceReason]=(summary.reasonCounts[r.hintPreferenceReason]??0)+1;else summary.unknownReasonRows++;if(summary.selected.length<32)summary.selected.push({line,actor:scalar(r.actor),phase:scalar(r.phase),truncated:false,...Object.fromEntries(fields.map(k=>[k,scalar(r[k])]))});else summary.selectedTruncated=true;},summary(){return{...summary,fieldContractObserved:summary.detailedRows>0&&summary.missingFieldRows===0&&summary.invalidTypeRows===0&&summary.unknownReasonRows===0,observationScope:summary.rows?'Only bounded scalar selection diagnostics were observed; no planning success, ACK, hit, throughput or causal-improvement credit.':'No selection diagnostic rows observed; schema coverage is not established.',notIndependentlyReplayedTyped900msPackets:true};}};\n}\nasync function verifyStoreCompanion(",
