+const SYSTEMS_PARSE_CACHE_IDENTITIES: usize = 256;
+const SYSTEMS_PARSE_CACHE_BLOB_BYTES: usize = 64 * 1024;
+// This bounds retained JSON, not the additional parsed-state heap or live Arcs.
+const SYSTEMS_PARSE_CACHE_JSON_BYTES: usize = 8 * 1024 * 1024;
+
+struct CachedSystemsParse {
+    identity: Stage5FriendIdentity,
+    json: Option<String>,
+    systems: Arc<Stage5SystemsState>,
+}
+
+struct SystemsParseCache {
+    entries: VecDeque<CachedSystemsParse>,
+    json_bytes: usize,
+}
+
+static SYSTEMS_PARSE_CACHE: Mutex<SystemsParseCache> = Mutex::new(SystemsParseCache {
+    entries: VecDeque::new(),
+    json_bytes: 0,
+});
+
+impl SystemsParseCache {
+    fn get(
+        &self,
+        identity: &Stage5FriendIdentity,
+        json: Option<&str>,
+    ) -> Option<Arc<Stage5SystemsState>> {
+        self.entries
+            .iter()
+            .find(|entry| &entry.identity == identity && entry.json.as_deref() == json)
+            .map(|entry| Arc::clone(&entry.systems))
+    }
+
+    fn insert(&mut self, entry: CachedSystemsParse, retired: &mut Vec<CachedSystemsParse>) {
+        if let Some(index) = self
+            .entries
+            .iter()
+            .position(|cached| cached.identity == entry.identity)
+        {
+            let previous = self.entries.remove(index).expect("selected cache entry");
+            self.json_bytes -= previous.json.as_ref().map_or(0, String::len);
+            retired.push(previous);
+        }
+        let bytes = entry.json.as_ref().map_or(0, String::len);
+        while self.entries.len() >= SYSTEMS_PARSE_CACHE_IDENTITIES
+            || self.json_bytes + bytes > SYSTEMS_PARSE_CACHE_JSON_BYTES
+        {
+            let previous = self.entries.pop_front().expect("bounded cache eviction");
+            self.json_bytes -= previous.json.as_ref().map_or(0, String::len);
+            retired.push(previous);
+        }
+        self.json_bytes += bytes;
+        self.entries.push_back(entry);
+    }
+}
