+#[test]
+fn stone_wrong_object_and_out_of_range_do_not_grant_or_debit() {
+    let mut session = stone(&[(135, "inProgress"), (153, "completed")], 40, 1);
+    call(&mut session, BIG_TAOIST, "@Main");
+    call(&mut session, BIG_TAOIST, "@stonetomba");
