# SK0 session spike — fill PACKAGE_ID/DAPP_*_ID from the `dubhe publish` output,
# FRAMEWORK_PACKAGE_ID from the canonical testnet Dubhe framework (store-config writes it).
# Never commit a real key — .env is gitignored.
OWNER_SECRET_KEY=suiprivkey1...        # the canonical owner (funded testnet wallet)
SESSION_SECRET_KEY=                     # optional; generated + must be funded if blank
PACKAGE_ID=0x...                        # sk_spike package id (after publish)
FRAMEWORK_PACKAGE_ID=0x...              # dubhe framework package id on testnet
DAPP_HUB_ID=0x...                       # shared DappHub object
DAPP_STORAGE_ID=0x...                   # sk_spike DappStorage shared object (from genesis)
