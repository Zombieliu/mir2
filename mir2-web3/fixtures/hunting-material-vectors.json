    { "name": "unsupported_schema", "input": { "schema_version": 2, "valuation_version": "fixture-v1", "entries": [] } },
    { "name": "unknown_root_field", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [], "market_fallback": true } },
    { "name": "missing_entries", "input": { "schema_version": 1, "valuation_version": "fixture-v1" } },
    { "name": "missing_version", "input": { "schema_version": 1, "entries": [] } },
    { "name": "empty_version", "input": { "schema_version": 1, "valuation_version": "", "entries": [] } },
    { "name": "space_version", "input": { "schema_version": 1, "valuation_version": " fixture-v1", "entries": [] } },
    { "name": "control_version", "input": { "schema_version": 1, "valuation_version": "fixture\u0000v1", "entries": [] } },
    { "name": "duplicate_index", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": 1 }, { "item_index": 1001, "unit_gold": 2 }] } },
    { "name": "zero_index", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 0, "unit_gold": 1 }] } },
    { "name": "negative_index", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": -1, "unit_gold": 1 }] } },
    { "name": "index_exceeds_i32", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 2147483648, "unit_gold": 1 }] } },
    { "name": "zero_unit_gold", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": 0 }] } },
    { "name": "unit_gold_exceeds_pg_limit", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": 9223372036854775808 }] } },
    { "name": "negative_unit_gold", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": -1 }] } },
    { "name": "fractional_unit_gold", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": 1.5 }] } },
    { "name": "string_unit_gold", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": "1" }] } },
    { "name": "boolean_index", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": true, "unit_gold": 1 }] } },
    { "name": "unknown_entry_field", "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": 1, "npc_fallback": true }] } }
