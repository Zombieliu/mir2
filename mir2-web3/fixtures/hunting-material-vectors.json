{
  "schema_version": 1,
  "fixture_only": true,
  "valid_valuations": [
    {
      "name": "empty_configuration_is_valid_but_prices_nothing",
      "input": { "schema_version": 1, "valuation_version": "fixture-empty-v1", "entries": [] },
      "expected": { "schema_version": 1, "valuation_version": "fixture-empty-v1", "entries": [] }
    },
    {
      "name": "entries_are_canonicalized_in_index_order",
      "input": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1002, "unit_gold": 51 }, { "item_index": 1001, "unit_gold": 1 }] },
      "expected": { "schema_version": 1, "valuation_version": "fixture-v1", "entries": [{ "item_index": 1001, "unit_gold": 1 }, { "item_index": 1002, "unit_gold": 51 }] }
    }
  ],
  "invalid_valuations": [
