# mir2 Player Web environment example.
#
# Normal Windows onboarding does not require an env file:
#   .\scripts\bootstrap-developer.ps1
#   .\scripts\start-developer.ps1 -OpenBrowser
#
# Copy this file to .env.local only for persistent overrides. Never commit
# credentials or secrets from a real environment.

# Asset selection
# ---------------
# Starter mode or a locally installed private developer bundle:
# leave both asset-base values empty.
#
# R2/CDN mode:
# use an immutable, versioned release root supplied by the maintainer, for
# example https://assets.example.com/mir2/v/<version>. Do not reuse an old hash
# from documentation. The root must include original-ui/, original-map/,
# generated/original-map-blend/, and generated/crystal-packs/full/index.json.
NEXT_PUBLIC_MIR2_ASSET_BASE_URL=

# Optional server-side alias. Use the same immutable release root when server
# routes need access without exposing a separate value to browser code.
MIR2_ASSET_BASE_URL=

# Optional same-origin development proxy target for private or restrictive R2
# endpoints. Most developers should leave this empty.
MIR2_R2_PROXY_BASE=

# Gateway
# -------
# The standard start script injects ws://127.0.0.1:7110/ws automatically.
# Set this only when Web connects to a separately managed Gateway.
NEXT_PUBLIC_MIR2_GATEWAY_WS_URL=

# Passkey authentication
# ----------------------
# Production/staging only. This value must match the Gateway secret used to
# verify issued tokens. Password-only local development can leave it empty.
MIR2_PASSKEY_AUTH_SECRET=
