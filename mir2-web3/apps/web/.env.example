# apps/web environment configuration.
#
# Copy to `.env.local` for local dev, or set these in the Vercel project env for
# deploys. Real `.env*` files are gitignored; only this `.env.example` is tracked.

# ── Original Crystal assets — REQUIRED for sprites & map tiles to render ───────
# Base URL of the hosted full asset release (R2). The `/original-ui/**` sprites
# (NPC, Monster, CArmour, CHair) and `/original-map/**` tiles live ONLY at this
# URL — the repo ships just their `meta.json`. If this is unset/empty the client
# falls back to local paths that have no PNGs and every sprite 404s with
# "[mir2] scene asset missing" (the game still runs; these are warnings).
#
# Chain: this var -> /api/asset-manifest (remoteAssets.assetBaseUrl)
#        -> window.__mir2AssetCache.remoteAssetBaseUrl -> sprite URLs rewritten to R2.
# Verify a deploy: open `<url>/api/asset-manifest` and confirm
#   remoteAssets.assetBaseUrl is the full release (NOT null).
# Example shape (use the current release; the path ends in the active version):
#   https://assets.mir2.obelisk.build/mir2/v/<hash>/...-fullcrystal-<rev>
#
# In LOCAL DEV, setting this in `.env.local` also auto-registers the asset Service
# Worker (normally prod-only), whose R2 fallback then covers SOUNDS too — so
# `/original-ui/Sound/*.wav` ids whose bytes are not committed locally (e.g.
# `62.wav`) resolve from R2 instead of 404ing. Leave it empty and only the 4
# committed .wavs resolve; the rest 404 harmlessly (audio degrades gracefully).
# Force the worker on/off in dev without a base URL via `?assetCache=1` / `=0`.
NEXT_PUBLIC_MIR2_ASSET_BASE_URL=

# ── Gateway WebSocket ─────────────────────────────────────────────────────────
# Local default: ws://127.0.0.1:7110/ws. Override for staging/hosted gateways.
# If unset outside localhost the client uses the production Gateway WSS default.
NEXT_PUBLIC_MIR2_GATEWAY_WS_URL=

# ── Passkey auth (production / staging) ───────────────────────────────────────
# Must match the Gateway's MIR2_PASSKEY_AUTH_SECRET so issued tokens verify.
MIR2_PASSKEY_AUTH_SECRET=
