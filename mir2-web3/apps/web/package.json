{
  "name": "mir2-web3-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "export:crystal-ui": "node ./scripts/export-crystal-ui.mjs",
    "export:crystal-sounds": "node ./scripts/export-crystal-sounds.mjs",
    "generate:crystal-asset-index": "node ./scripts/generate-crystal-asset-index.mjs",
    "generate:original-asset-manifest": "node ./scripts/generate-original-asset-manifest.mjs",
    "generate:crystal-map-runtime": "node ./scripts/generate-crystal-map-runtime-data.mjs",
    "assets:prepare": "npm run generate:crystal-asset-index && npm run export:crystal-sounds && npm run export:crystal-ui && npm run export:crystal-map && npm run generate:original-asset-manifest",
    "assets:verify": "npm run generate:crystal-asset-index && npm run generate:original-asset-manifest && npm run smoke:crystal-minimap-assets && npm run audit:crystal-map-coverage && npm run audit:crystal-map-gameplay",
    "export:crystal-map": "node ./scripts/export-crystal-starter-map.mjs",
    "generate:crystal-map-blend": "node ./scripts/generate-crystal-map-blend-assets.mjs",
    "audit:crystal-map-coverage": "node ./scripts/audit-crystal-map-coverage.mjs",
    "audit:crystal-map-gameplay": "node ./scripts/audit-crystal-map-gameplay.mjs",
    "smoke:crystal-assets": "node ./scripts/smoke-crystal-assets.mjs",
    "smoke:crystal-map-api": "node ./scripts/smoke-crystal-map-api.mjs",
    "qa:capture-map-monsters": "node ./scripts/capture-production-map-monsters.mjs",
    "smoke:crystal-minimap-assets": "node ./scripts/smoke-crystal-minimap-assets.mjs",
    "smoke:cache-metrics": "node ./scripts/smoke-cache-metrics.mjs",
    "smoke:bevy-runtime-backends": "node ./scripts/smoke-bevy-runtime-backends.mjs",
    "smoke:cache-maintenance": "node ./scripts/smoke-cache-metrics.mjs --exerciseMaintenance true",
    "smoke:playable-metrics": "node ./scripts/smoke-cache-metrics.mjs --mode playable",
    "smoke:production-original-assets": "node ./scripts/smoke-production-original-assets.mjs",
    "smoke:production-bevy-runtime": "node ./scripts/smoke-production-bevy-runtime.mjs",
    "smoke:production-asset-runtime": "npm run smoke:production-original-assets && npm run smoke:production-bevy-runtime",
    "release:doctor": "node ./scripts/release-doctor.mjs",
    "assets:remote:build": "node ./scripts/build-remote-asset-release.mjs",
    "assets:r2:dry-run": "node ./scripts/upload-r2-assets.mjs --dryRun true",
    "assets:r2:upload": "node ./scripts/upload-r2-assets.mjs",
    "assets:bevy-entity-atlas:build": "node ./scripts/build-bevy-entity-atlas-pack.mjs",
    "vercel:prune-output": "node ./scripts/prune-vercel-output-assets.mjs",
    "vercel:build:prod": "npx vercel@latest build --prod --yes && npm run vercel:prune-output",
    "vercel:deploy:prod": "npx vercel@latest deploy --prebuilt --prod --archive=tgz --yes",
    "smoke:reconnect-resume": "node ./scripts/smoke-reconnect-resume.mjs",
    "smoke:two-client-zone": "node ./scripts/smoke-two-client-zone.mjs",
    "smoke:stage5-ui": "node ./scripts/smoke-stage5-ui.mjs",
    "smoke:gateway-capacity": "node ./scripts/load-gateway-ws.mjs",
    "load:gateway-ws": "node ./scripts/load-gateway-ws.mjs",
    "test:movement-controller": "node ./scripts/test-movement-controller.mjs",
    "test:minimap-transform": "node ./scripts/test-minimap-transform.mjs",
    "test:resource-loading": "npm run generate:original-asset-manifest && node ./scripts/test-resource-loading.mjs",
    "runtime:build:dev": "node ./scripts/build-bevy-runtime.mjs dev",
    "runtime:build:release": "node ./scripts/build-bevy-runtime.mjs release",
    "dev": "npm run runtime:build:dev && next dev",
    "build": "npm run runtime:build:release && npm run generate:original-asset-manifest && next build",
    "start": "next start"
  },
  "dependencies": {
    "@mysten/sui": "^2.16.2",
    "@mysten/wallet-standard": "^0.20.3",
    "next": "16.2.1",
    "nipplejs": "^1.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
