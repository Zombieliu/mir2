# Mir2 production AI daily report configuration.
# Never commit real database, model API, operator, or Discord webhook secrets.

ADMIN_DATABASE_URL=postgres://mir2:change-me@postgres:5432/mir2
ADMIN_CLICKHOUSE_URL=http://clickhouse:8123
ADMIN_CLICKHOUSE_DATABASE=mir2_events
ADMIN_CLICKHOUSE_USER=mir2
ADMIN_CLICKHOUSE_PASSWORD=change-me

# Asia/Shanghai: UTC+8. The scheduler generates the completed previous local
# day at 09:00 and keeps retrying due Discord deliveries every 30 seconds.
ADMIN_DAILY_REPORT_TIMEZONE=Asia/Shanghai
ADMIN_DAILY_REPORT_TIMEZONE_OFFSET_MINUTES=480
ADMIN_DAILY_REPORT_SCHEDULE_HOUR=9
ADMIN_DAILY_REPORT_SCHEDULE_MINUTE=0
ADMIN_DAILY_REPORT_SCHEDULER_ENABLED=true

# Keep manual review in production. Only enable auto publication after a
# shadow-mode period and an explicit operational decision.
ADMIN_DAILY_REPORT_AUTO_PUBLISH=false

# OpenAI-compatible chat-completions endpoint. The model sees aggregate
# metrics only and must return strict JSON.
ADMIN_DAILY_REPORT_AI_ENDPOINT=https://model-gateway.example.com/v1/chat/completions
ADMIN_DAILY_REPORT_AI_API_KEY=
ADMIN_DAILY_REPORT_AI_MODEL=gpt-5-mini
ADMIN_DAILY_REPORT_HTTP_TIMEOUT_SECONDS=20

# Create a dedicated Discord channel webhook and store the full URL only in
# the deployment secret manager. The URL is never returned by the API.
ADMIN_DAILY_REPORT_DISCORD_WEBHOOK_URL=
ADMIN_DAILY_REPORT_DISCORD_DESTINATION_LABEL=mir2-world-news
