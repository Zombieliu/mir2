{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dubhe Node",
  "version": "0.1.0",
  "identifier": "com.obelisklabs.dubhenode",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dubhe Node",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/home_agent",
      "binaries/home_agent_launcher",
      "binaries/home_agent_supervisor",
      "binaries/zone_host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
