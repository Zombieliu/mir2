# MIR2 on-chain mine — environment template.
# COPY this to `.env` (gitignored) and fill values LOCALLY.
# NEVER commit real secrets (private keys, mnemonics, operator tokens).

# --- Sui network (testnet only until the M8 mainnet go) ---
SUI_NETWORK=testnet
SUI_FULLNODE_URL=https://fullnode.testnet.sui.io:443

# --- Deployer / admin key for scripts & relayer (M1+) ---
# Prefer referencing a Sui keystore alias over pasting a raw key.
# If a raw key is unavoidable, it goes ONLY here in .env (gitignored).
# Placeholder below is NOT a real key — do not use it.
# SUI_PRIVATE_KEY=suiprivkey1qq...placeholder...
SUI_PRIVATE_KEY=

# --- On-chain mine package (filled after the M1 testnet deploy) ---
MINE_PACKAGE_ID=

# --- Relayer -> gateway/admin-api injection (M2/M3) ---
# Operator token authorises the relayer to inject chain-confirmed commands.
# Via env only — never in the repo.
GATEWAY_INJECT_URL=
OPERATOR_TOKEN=

# --- Dubhe Indexer / GraphQL (M2) ---
INDEXER_GRAPHQL_URL=http://localhost:4000/graphql
INDEXER_GRAPHQL_WS=ws://localhost:4000/graphql
