# MIR2 on-chain mine — environment template.
# COPY this to `.env` (gitignored) and fill values LOCALLY.
# NEVER commit real secrets (private keys, mnemonics, operator tokens).

# --- Sui network (testnet only until the M8 mainnet go) ---
SUI_NETWORK=testnet
SUI_FULLNODE_URL=https://fullnode.testnet.sui.io:443

# --- Deployer / admin / miner key for dubhe + the TS smoke (M1+) ---
# Used by `dubhe publish` and scripts/smoke-mine.ts (process.env.PRIVATE_KEY).
# Accepts suiprivkey (bech32) / base64 / hex. Goes ONLY here in .env (gitignored).
# Export from the keystore locally: `sui keytool export --key-identity mir2-onchain-mine`.
# Fill the value of PRIVATE_KEY locally (suiprivkey / base64 / hex) — never commit it.
PRIVATE_KEY=

# --- On-chain mine deployment (testnet; public ids — safe to keep here) ---
MINE_PACKAGE_ID=0xe6c3602e4055b76afd82a48745f9cd34daa4a6dce1f420747f0779732640dbe5
MINE_SCHEMA_ID=0x77138ceee249ef3d328296cb932cbad50916bf062d06cb6d1ee7ea0ea1acc698

# --- Relayer -> gateway/admin-api injection (M2/M3) ---
# Operator token authorises the relayer to inject chain-confirmed commands.
# Via env only — never in the repo.
GATEWAY_INJECT_URL=
OPERATOR_TOKEN=

# --- Dubhe Indexer / GraphQL (M2) ---
INDEXER_GRAPHQL_URL=http://localhost:4000/graphql
INDEXER_GRAPHQL_WS=ws://localhost:4000/graphql
