#[expected_failure(abort_code=100,location=mir2_procurement::intent)]
fun cross_dapp_replay_rejected() {
    verify_oracle_domain(x"20e8a929afcb77ffb9e0e0b4633b03ca00b2f17f92bdff9cc77bef02e8bc966c7ad7405dd25b0e60360af8d4c3ccef86fcc69cea62b338007977da4484dda000", 1,
        @0x2222222222222222222222222222222222222222222222222222222222222222,
