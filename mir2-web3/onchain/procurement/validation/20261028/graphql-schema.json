      {
        "name": "eventBcs",
        "description": "The Base64 encoded BCS serialized bytes of the entire Event structure from sui-types.\nThis includes: package_id, transaction_module, sender, type, and contents (which itself contains the BCS-serialized Move struct data)."
      },
      {
        "name": "sender",
        "description": "Address of the sender of the transaction that emitted this event."
      },
      {
        "name": "sequenceNumber",
        "description": "The position of the event among the events from the same transaction."
      },
      {
        "name": "timestamp",
        "description": "Timestamp corresponding to the checkpoint this event's transaction was finalized in.\nAll events from the same transaction share the same timestamp.\n\n`null` for simulated/executed transactions as they are not included in a checkpoint."
      },
      {
        "name": "transaction",
        "description": "The transaction that emitted this event. This information is only available for events from indexed transactions, and not from transactions that have just been executed or dry-run."
      },
      {
        "name": "transactionModule",
        "description": "The module containing the function that was called in the programmable transaction, that resulted in this event being emitted."
