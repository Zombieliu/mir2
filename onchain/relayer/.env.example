# Relayer config (M2/M4). Placeholders only — NEVER commit a real .env or token.
# Copy to onchain/.env (gitignored) and fill in.

# --- Sui event source (WF-3) ---
# The deployed mine package (onchain/deployments/testnet.json -> packageId).
MINE_PACKAGE_ID=0x...
SUI_NETWORK=testnet
# Move modules whose events are bridged (DESIGN §4).
RELAYER_MODULES=mine_system,redeem_system
RELAYER_POLL_MS=4000
# Where the (txDigest,eventSeq) dedup cursor + seen-set persist (idempotency #2).
RELAYER_STATE_DIR=relayer/.state

# --- Gateway injection sink (WF-5, M4) ---
# The gateway's on-chain inject route. MUST end in /onchain/inject. The local web
# gateway listens where MIR2_GATEWAY_WEB_ADDR points (the e2e runbook uses 7110 to
# match the web client's default ws://127.0.0.1:7110/ws).
# Absent => log-only sink (the M2 default; nothing is injected).
GATEWAY_INJECT_URL=http://127.0.0.1:7110/onchain/inject
# Operator bearer token. MUST equal the gateway's MIR2_GATEWAY_OPERATOR_TOKEN
# (apps/gateway/src/auth.rs::verify_operator_token). Env-only, never committed.
OPERATOR_TOKEN=replace-with-a-long-random-secret
