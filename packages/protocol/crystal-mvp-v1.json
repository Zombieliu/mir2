{
  "name": "crystal-mvp-v1",
  "source_root": "E:/mir2/Crystal/Shared",
  "framing": {
    "length_prefix": "u16_le",
    "packet_id": "i16_le",
    "payload_size_formula": "length - 4",
    "string_encoding": ".NET BinaryWriter string (7-bit length prefix + UTF-8 bytes)",
    "compression": "supported by base protocol, not used by MVP packets"
  },
  "enums": {
    "MirGender": {
      "type": "u8",
      "values": {
        "Male": 0,
        "Female": 1
      }
    },
    "MirClass": {
      "type": "u8",
      "values": {
        "Warrior": 0,
        "Wizard": 1,
        "Taoist": 2,
        "Assassin": 3,
        "Archer": 4
      }
    },
    "MirDirection": {
      "type": "u8",
      "values": {
        "Up": 0,
        "UpRight": 1,
        "Right": 2,
        "DownRight": 3,
        "Down": 4,
        "DownLeft": 5,
        "Left": 6,
        "UpLeft": 7
      }
    },
    "ChatType": {
      "type": "u8",
      "values": {
        "Normal": 0,
        "Shout": 1,
        "System": 2,
        "Hint": 3,
        "Announcement": 4,
        "Group": 5,
        "WhisperIn": 6,
        "WhisperOut": 7,
        "Guild": 8,
        "Trainer": 9,
        "LevelUp": 10,
        "System2": 11,
        "Relationship": 12,
        "Mentor": 13,
        "Shout2": 14,
        "Shout3": 15,
        "LineMessage": 16
      }
    }
  },
  "shared_structs": {
    "SelectInfo": {
      "fields": [
        { "name": "index", "type": "i32" },
        { "name": "name", "type": "string" },
        { "name": "level", "type": "u16" },
        { "name": "class", "type": "MirClass" },
        { "name": "gender", "type": "MirGender" },
        { "name": "last_access_binary_datetime", "type": "i64" }
      ]
    }
  },
  "client_packets": [
    {
      "id": 0,
      "name": "ClientVersion",
      "fields": [
        { "name": "hash_length", "type": "i32" },
        { "name": "version_hash", "type": "bytes", "length_from": "hash_length" }
      ]
    },
    {
      "id": 1,
      "name": "Disconnect",
      "fields": []
    },
    {
      "id": 2,
      "name": "KeepAlive",
